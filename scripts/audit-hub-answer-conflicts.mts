// scripts/audit-hub-answer-conflicts.mts
//
// Lists, for every MBA hub that renders <QuickAnswers>, which sections it got
// and which fact types were left out because the hub's own page-content JSON
// states them differently from lib/data.ts / lib/fees.ts (CONFLICT RULE).
// The JSON is never changed by the sprint; this report is the fix list.
//
//   npx tsx scripts/audit-hub-answer-conflicts.mts            (current rollout)
//   npx tsx scripts/audit-hub-answer-conflicts.mts --rollout=D
import fs from 'node:fs'
import { UNIVERSITIES } from '../lib/data.ts'
import { getHubAnswers, isHubCandidate, HUB_ROLLOUT, HUB_BATCH_A } from '../lib/answers/hub-answers.ts'

const arg = process.argv.find(a => a.startsWith('--rollout='))
const rollout = (arg ? arg.split('=')[1] : HUB_ROLLOUT) as 'A' | 'D'
const rendered: string[] = [], below: string[] = [], conflicts: string[] = []
for (const u of UNIVERSITIES) {
  if (!isHubCandidate(u)) continue
  if (rollout === 'A' && !HUB_BATCH_A.includes(u.id)) continue
  const h = getHubAnswers(u, rollout)
  if (!h) { below.push(u.id); continue }
  rendered.push(`| /universities/${u.id}/mba | ${h.backed} | ${h.sections.map(s => s.key).join(', ')} | ${h.faqs.length} |`)
  for (const c of h.conflicts) conflicts.push(`| ${u.id} | ${c.kind} | ${c.snippet.replace(/\|/g, '/')} |`)
}
const md = `# QuickAnswers on MBA hubs: sections and conflicts (rollout ${rollout})

Generated by \`scripts/audit-hub-answer-conflicts.mts\`. Hubs: ${rendered.length} rendered, ${below.length} below the ${5}-backed minimum.

## Rendered

| Hub | Backed | Sections | FAQ items appended |
|---|---|---|---|
${rendered.join('\n')}

## Left out because the hub's page-content JSON disagrees

Each row is an existing JSON sentence about the university that states the fact
differently from lib/data.ts or lib/fees.ts. The new sections leave that fact
type out; the JSON sentence is unchanged and is the thing to fix. "placements"
means the JSON has its own placement copy, so no Q3 section was added.

| University | Fact | Existing JSON sentence |
|---|---|---|
${conflicts.join('\n')}

## Below the minimum

${below.length ? below.map(id => `- ${id}`).join('\n') : 'None.'}
`
const out = `audits/ai-citation-hub-answers-${rollout}-2026-11-04.md`
fs.writeFileSync(out, md)
console.log(`${out}: ${rendered.length} rendered, ${conflicts.length} conflicts, ${below.length} below minimum`)
