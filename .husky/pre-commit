#!/bin/sh
# Pre-commit checks for edifyedu.in. Committed to the repo so hooks survive a
# fresh clone. Activated by "npm install" via the package.json prepare script,
# which sets: git config core.hooksPath .husky

echo "pre-commit: verify-fees"
node scripts/verify-fees.js || exit 1

echo "pre-commit: check-em-dash"
node scripts/check-em-dash.js || exit 1

# Sprint 3 Fix 2b: per-file em-dash baseline across app/**/*.tsx and
# components/**/*.tsx. Mirrors the fee-mismatch baseline mechanic.
# Blocks any commit that raises a file above its allowed count. Auto-drops
# the baseline (and stages it) when counts fall.
echo "pre-commit: check-em-dash-baseline"
node scripts/check-em-dash-baseline.mjs || exit 1

# Sprint 2 Phase A: rising-count gate on getDisplayFee suppressions.
# Blocks any commit that raises the mismatch total above the baseline in
# data/fee-mismatch-baseline.json. Baseline is auto-updated on decrease.
echo "pre-commit: check-fee-baseline"
node scripts/check-fee-baseline.mjs || exit 1

# Blog fee ratchet. Blocks any per-slug increase in unverified blog fee
# figures and any fee figure in a brand-new post. See scripts/check-blog-fees.mjs.
echo "pre-commit: check-blog-fees"
npx tsx scripts/check-blog-fees.mjs || exit 1

# Duplicate-slug gate. Blocks any commit that introduces a slug collision
# in BLOG_POSTS. Runtime .find() picks the first match and would render
# only one of the entries, so a duplicate is always a bug. See
# audits/duplicate-blog-slugs-2026-08-11.md.
echo "pre-commit: check-duplicate-slugs"
npx tsx scripts/check-duplicate-slugs.mjs || exit 1

# Sprint 3 Task 1: never-both invariant for the hub thin-page gate.
# Blocks any commit where a hub URL is listed in valid-urls.json AND would
# emit robots noindex from shouldIndexProgrammeHub. See
# scripts/prune-noindex-hub-urls.mjs for the fix.
echo "pre-commit: check-sitemap-noindex-drift"
node scripts/prune-noindex-hub-urls.js --check || exit 1

# Spec rescue gate. Blocks any commit that lets a /universities/*/{mba|bba|bca|mca}/*
# sitemap URL resolve to null (would 404 in production), or any commit that
# re-widens the resolveSpecName rescue so nonsense slugs render as fabricated
# 200 pages. See audits/fabricated-spec-urls-2026-08-17.csv.
echo "pre-commit: check-spec-rescue"
npx tsx scripts/check-spec-rescue.ts || exit 1

# Task 3 slice 1: middleware allowlist ↔ resolver invariant. Blocks any commit
# where the pre-generated lib/data/programme-allowlist-*.json disagrees with
# lib/seo/resolve-programme.ts on any (uni, programme) in scope. Without this,
# the middleware becomes a second independent source of truth and can either
# 404 legitimate unis or let class-A phantom hubs through the edge.
echo "pre-commit: check-programme-allowlist-resolver"
npx tsx scripts/check-programme-allowlist-resolver.ts || exit 1

# Spec allowlist invariant. Blocks any commit where lib/data/spec-allowlist.json
# disagrees with resolveSpec(), or where a sitemap spec URL is absent from it.
# Middleware section 2f 404s specialisations at the edge using this file, so a
# stale or too-narrow list would 404 pages that render real content.
echo "pre-commit: check-spec-allowlist"
npx tsx scripts/check-spec-allowlist.ts || exit 1

# Sitemap canonicality. Blocks any commit where valid-urls.json advertises a URL
# that redirects, and any commit where url-canonical-map.json has drifted from
# resolveSpec / the programmes route. A sitemap full of redirect sources burns
# crawl budget and splits signals across two URLs for the same page.
echo "pre-commit: check-url-canonical-map"
npx tsx scripts/build-url-canonical-map.mts --check || exit 1
node scripts/apply-url-canonical-map.js --check || exit 1

# Ranking-page protection. Blocks any commit that would make a URL with real
# Search Console history 404 with no redirect standing in front of it. See the
# header of scripts/check-gsc-404s.mts for why this is a rule, not a cleanup.
echo "pre-commit: check-gsc-404s"
npx tsx scripts/check-gsc-404s.mts || exit 1

# Duplicate specialisation titles. Two pages at the same university and
# programme sharing a <title> is a duplicate-content signal and reads badly in a
# SERP. Found 2026-08-30 by crawling the sitemap: 7 groups covering 15 pages.
echo "pre-commit: check-duplicate-spec-titles"
npx tsx scripts/check-duplicate-spec-titles.mts || exit 1

# Task 3 slice 3c: never-both-404 and never-both-redirect invariants on the
# actual sitemap() output. Blocks any commit where a HUB URL in the sitemap
# would be 404'd by the middleware allowlist (class-A/B/C), or where any
# sitemap URL is an exact source in lib/data/redirects.json. Reads
# app/sitemap.ts so force-adds (RESCUED_PROGRAM_PATHS) are covered too.
echo "pre-commit: check-sitemap-vs-404"
npx tsx scripts/check-sitemap-vs-404.ts || exit 1

# Typecheck scripts/ so they don't rot. next build excludes this directory
# (see tsconfig.json exclude), so the only place scripts get typechecked is
# here. Uses tsconfig.scripts.json which sets target: es2020.
echo "pre-commit: typecheck:scripts"
npx tsc --noEmit -p tsconfig.scripts.json || exit 1

echo "pre-commit: all checks passed"
